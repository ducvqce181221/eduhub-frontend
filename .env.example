# Public API URL (in browser) or local dev URL
NEXT_PUBLIC_API_URL=http://localhost:5000

# Backend URL used by Next.js Server / Rewrites to proxy requests (e.g. Render Web Service URL)
BACKEND_INTERNAL_URL=http://localhost:5000

# Cloudflare Turnstile CAPTCHA Site Key
# Get from Cloudflare Dashboard -> Turnstile -> Add site
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
